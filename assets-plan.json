      "sources": [
        "work/ui-sources/shadcn-ui/apps/v4/registry/bases/radix/ui/accordion.tsx",
        "work/ui-sources/obsidian-ui/src/components/analytics-dashboard/details.tsx"
      ],
      "project_paths": ["src/components/ui/Disclosure.jsx"],
      "trigger": "click and keyboard",
      "dynamic": true
    },
    {
      "id": "morph-select",
      "purpose": "Wordbook switching",
      "kind": "source-adapted-interaction",
      "source": "Transitions.dev Dropdown menu morph",
      "source_path": "work/ui-sources/transitions-dev/transitions/dropdown-menu-morph/index.html",
      "project_paths": ["src/components/ui/MorphSelect.jsx"],
      "trigger": "click, outside click, Escape",
